# =============================================================================
# THE FIXED BENCHMARK DATASET (docs/OPTIMIZATION_PLAN.md §1)
#
# Sourced by scripts/make_marmousi_dataset.sh (how the files were made) and by
# scripts/pod/bench.sh (how every engine is run on them). Nothing else may
# choose these numbers. Change them and every result becomes incomparable.
# =============================================================================
DATASET_NAME=marmousi12

# files (relative to the repo root)
MARMOUSI_VEL=data/real/marmousi_vp_12.5m.bin        # 1361 x 281 cells, 12.5 m, zfast
MARMOUSI_SHOTS=data/real/marmousi_shots.bin         # RTMS: 12 shots x 341 receivers x 2800 samples
MARMOUSI_CHECKSUMS=data/real/marmousi_dataset.sha256
REFERENCE_IMAGE=results/ref/marmousi_ref.bin        # CPU reference image, made once on the pod

# how the velocity file was made (segy_to_raw.py on the AGL Marmousi2 P-wave model)
SEGY_DECIMATION=10          # 1.25 m -> 12.5 m
VMIN_CLIP=1000

# how the shots were modelled (rtm_synth, CPU reference engine)
NSHOTS=12
NT=2800
DT=0.001
F0=10
REC_DX=50
SRC_Z=25
REC_Z=25

# how every engine migrates them (rtm)
ORDER=8
NB=50
STORE_INTERVAL=10
MUTE_VELOCITY=1500
